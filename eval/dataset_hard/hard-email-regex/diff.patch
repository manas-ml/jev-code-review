+"""Signup policy."""
+
+from __future__ import annotations
+
+import re
+
+CORP = re.compile(r"^[\w.+-]+@corp\.com")
+
+
+def allowed(email: str) -> bool:
+    return CORP.match(email.strip().lower()) is not None
