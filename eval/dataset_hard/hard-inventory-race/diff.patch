+++ b/shop/test_inventory.py
@@ -0,0 +1,10 @@
+from shop.inventory import Inventory
+
+
+def test_reserve_and_release():
+    inv = Inventory()
+    inv.restock("a", 2)
+    assert inv.reserve("a", 2)
+    assert not inv.reserve("a", 1)
+    inv.release("a", 2)
+    assert inv.available("a") == 2
