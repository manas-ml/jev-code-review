# Required for real runs: Jev, agents, verifier and the eval match judge all use OpenRouter.
OPENROUTER_API_KEY=
# Needed for --pr, --post and scripts/bootstrap_dataset.py.
GITHUB_TOKEN=
# real | mock. mock uses an offline heuristic judge instead of Jev (dev/tests only).
JEV_MODE=mock

# Optional overrides
# JEV_MODEL=typesafe/jev-1.13
# AGENT_MODEL=deepseek/deepseek-v4.1-flash
# VERIFIER_MODEL=deepseek/deepseek-v4.1-flash
# MATCH_JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# POST_MIN_SEVERITY=3
# MAX_CONCURRENCY=4
# Calibrated gate thresholds written by `codereview calibrate`:
# GATE_OVERRIDES_FILE=runs/compare_hard/calibrated_gate.json
